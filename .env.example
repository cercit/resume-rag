# Copy to .env (never commit .env). Values come from the Supabase dashboard and OpenRouter.
# Supabase > Project Settings > API
SUPABASE_URL=https://jkionnbbtnwloavmhcdn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase > Project Settings > Database (used by `supabase link` / `db push`)
SUPABASE_DB_PASSWORD=
# Only for cloud sessions without `supabase login` (Account > Access Tokens)
SUPABASE_ACCESS_TOKEN=
# OpenRouter (goes to Edge Function secrets via scripts/set_secrets.py)
LLM_API_KEY=
LLM_MODEL_GENERATE=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODEL_TWEAK=nvidia/nemotron-3.5-lightning:free
ALLOWED_ORIGIN=https://cercit.github.io
